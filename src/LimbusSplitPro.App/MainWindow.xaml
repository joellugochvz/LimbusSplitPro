<Window x:Class="LimbusSplitPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:LimbusSplitPro.App.Views"
        mc:Ignorable="d"
        Title="Limbus Split Pro" Height="780" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0A0A0F"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AllowDrop="True"
        Drop="OnWindowDrop">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- PlayerBar -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#0D0D14" Height="40">
            <DockPanel LastChildFill="True">
                
                <!-- Left: Logo and Title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#00E5FF" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="14">
                        <Run Text="LIMBUS" FontWeight="Bold"/>
                        <Run Text=" "/>
                        <Run Text="SPLIT PRO" FontWeight="Light"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right: Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Badge -->
                    <Border Background="#1A1A24" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,20,0" VerticalAlignment="Center" Height="24">
                        <TextBlock Text="🔒 PROCESAMIENTO LOCAL" Foreground="#00E5FF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Window Buttons -->
                    <Button Click="OnMinimizeClick" Width="46" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Content="─">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2D3B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="OnMaximizeClick" Width="46" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Content="□">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2D3B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="OnCloseClick" Width="46" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Content="✕">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                
                <!-- Drag Area (Fill remaining space) -->
                <Border Background="Transparent" MouseDown="OnTitleBarMouseDown" WindowChrome.IsHitTestVisibleInChrome="True" />
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:ControlPanel Grid.Column="0" Width="380" MinWidth="320" MaxWidth="460" Margin="0,0,0,0" />
            <views:MixerPanel Grid.Column="1" Margin="24" />
        </Grid>

        <!-- Player Bar at the bottom -->
        <views:PlayerBar Grid.Row="2" />
    </Grid>
</Window>
