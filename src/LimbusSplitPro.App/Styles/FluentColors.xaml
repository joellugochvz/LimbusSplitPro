<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Solid Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0F"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#12141A"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1A1D26"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1E2230"/>
    
    <!-- Accent Colors -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#00F0FF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#33F3FF"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#A855F7"/>
    
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#4B5563"/>
    
    <!-- Gradients -->
    <LinearGradientBrush x:Key="NeonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F0FF" Offset="0.0"/>
        <GradientStop Color="#A855F7" Offset="1.0"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D0D14" Offset="0.0"/>
        <GradientStop Color="#12141A" Offset="1.0"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="SplitButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F0FF" Offset="0.0"/>
        <GradientStop Color="#A855F7" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Effects -->
    <DropShadowEffect x:Key="NeonGlowEffect" Color="#00F0FF" BlurRadius="15" Opacity="0.4" ShadowDepth="0" Direction="0"/>

</ResourceDictionary>
