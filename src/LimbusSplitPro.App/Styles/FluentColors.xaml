<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Modern Color Palette -->
    <Color x:Key="WindowBackgroundColor">#0F1115</Color>
    <Color x:Key="CardBackgroundColor">#181B22</Color>
    <Color x:Key="CardHoverColor">#20242D</Color>
    <Color x:Key="BorderColor">#2A2E39</Color>
    
    <Color x:Key="PrimaryAccentColor">#0078D4</Color>
    <Color x:Key="PrimaryAccentHoverColor">#1084D9</Color>
    <Color x:Key="SuccessColor">#107C41</Color>
    <Color x:Key="DangerColor">#E74C3C</Color>
    <Color x:Key="WarningColor">#F39C12</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A0A5B1</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

</ResourceDictionary>
