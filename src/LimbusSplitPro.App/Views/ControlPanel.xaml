<UserControl x:Class="LimbusSplitPro.App.Views.ControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="380">
    <Border Background="#0E1017" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewerStyle}">
            <StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- Section 01 · MEZCLA -->
                <!-- ═══════════════════════════════════════════ -->
                <TextBlock Text="01 · MEZCLA" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,10" />

                <!-- Drop Zone (visible when NO file loaded) -->
                <Border Background="#12141A" CornerRadius="12" BorderBrush="#1E2230" BorderThickness="1" Padding="20" Margin="0,0,0,8"
                        AllowDrop="True" Drop="OnDropZoneDrop" DragOver="OnDropZoneDragOver"
                        Visibility="{Binding SelectedInputFilePath, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Suelta aquí tu mezcla" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="WAV, MP3, FLAC o AIF" Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <Button Content="Elegir archivo" Style="{StaticResource FluentSecondaryButtonStyle}" Click="OnSelectInputFileClick" HorizontalAlignment="Center" Padding="16,8" />
                    </StackPanel>
                </Border>

                <!-- Loaded file info (visible when file IS loaded) -->
                <Border Background="#12141A" CornerRadius="10" Padding="12" Margin="0,0,0,20"
                        Visibility="{Binding SelectedInputFilePath, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#1A1D26" Margin="0,0,10,0">
                            <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InputFileInfo.FileName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding InputFileInfo.FormattedFormat}" Foreground="#6B7280" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕" Click="OnSelectInputFileClick" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#6B7280" FontSize="14" Cursor="Hand" Padding="4" ToolTip="Cambiar archivo" />
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- Section 02 · QUÉ EXTRAER (hidden while processing) -->
                <!-- ═══════════════════════════════════════════ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="02 · QUÉ EXTRAER" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Todas" Style="{StaticResource FluentSecondaryButtonStyle}" Click="OnSelectAllClick" Padding="8,4" FontSize="10" Margin="0,0,4,0" />
                            <Button Content="Ninguna" Style="{StaticResource FluentSecondaryButtonStyle}" Click="OnSelectNoneClick" Padding="8,4" FontSize="10" />
                        </StackPanel>
                    </Grid>

                    <!-- Stems Grid (2 columns) -->
                    <ItemsControl ItemsSource="{Binding StemSelection.Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="stemCard" CornerRadius="10" Padding="10" Margin="3" BorderThickness="1.5" Cursor="Hand"
                                        Background="#12141A" BorderBrush="#1E2230" MouseLeftButtonDown="OnStemCardClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Foreground="#4B5563" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center"
                                                  Style="{StaticResource DarkCheckBoxStyle}" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="stemCard" Property="BorderBrush" Value="#00F0FF" />
                                        <Setter TargetName="stemCard" Property="Background" Value="#0D1A1F" />
                                        <Setter TargetName="stemCard" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Other reúne lo no seleccionado. Voces es la base: al elegir Voz principal, Coros o Efectos vocales se activa y exporta automáticamente."
                               Foreground="#4B5563" FontSize="10" TextWrapping="Wrap" Margin="4,8,4,20" />
                </StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- Section 03 · CARPETA DE TRABAJO -->
                <!-- ═══════════════════════════════════════════ -->
                <TextBlock Text="03 · CARPETA DE TRABAJO" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,10" />

                <Border Background="#12141A" CornerRadius="10" Padding="12" Margin="0,0,0,20" BorderBrush="#1E2230" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📁" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pistas separar" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OutputFolderPath}" Foreground="#6B7280" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Cambiar" Style="{StaticResource FluentSecondaryButtonStyle}" Click="OnSelectFolderClick" Padding="10,6" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- Section 04 · ACELERACIÓN HARDWARE -->
                <!-- ═══════════════════════════════════════════ -->
                <TextBlock Text="04 · ACELERACIÓN" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}"
                          SelectedIndex="0"
                          Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,20" />

                <!-- ═══════════════════════════════════════════ -->
                <!-- CTA BUTTON: SPLIT -->
                <!-- ═══════════════════════════════════════════ -->
                <Button Command="{Binding StartSeparationCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" Height="48" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="splitBorder" CornerRadius="12" Padding="16,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00F0FF" Offset="0" />
                                        <GradientStop Color="#A855F7" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="✦  Split" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="splitBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="splitBorder" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cancel Button (visible during processing) -->
                <Button Command="{Binding CancelSeparationCommand}" Height="38" Cursor="Hand" Margin="0,10,0,0"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cancelBorder" CornerRadius="10" BorderThickness="1.5" Padding="16,0"
                                    BorderBrush="#EF4444" Background="#1A0808">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cancelar proceso" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cancelBorder" Property="Background" Value="#2A0D0D"/>
                                    <Setter TargetName="cancelBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#EF4444" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="cancelBorder" Property="Background" Value="#3D1212"/>
                                    <Setter TargetName="cancelBorder" Property="BorderBrush" Value="#FF6B6B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
