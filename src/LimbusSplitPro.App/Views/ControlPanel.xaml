<UserControl x:Class="LimbusSplitPro.App.Views.ControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="360">
    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- App Header Logo & Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="36" Height="36" Background="{StaticResource PrimaryAccentBrush}" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Limbus Split Pro" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Motor Local de Separación IA" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Section 1: Audio Input Selector -->
                <Border Background="#20242D" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1. Archivo de Entrada" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <Button Content="🎵 Seleccionar / Arrastrar Canción" Style="{StaticResource FluentSecondaryButtonStyle}" Click="OnSelectInputFileClick" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedInputFilePath, TargetNullValue='Ningún archivo seleccionado'}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Section 2: Stem Category Selection -->
                <Border Background="#20242D" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="2. Pistas a Extraer" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Todas" Style="{StaticResource FluentSecondaryButtonStyle}" Command="{Binding StemSelection.SelectAllCommand}" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                <Button Content="Ninguna" Style="{StaticResource FluentSecondaryButtonStyle}" Command="{Binding StemSelection.SelectNoneCommand}" Padding="6,2" FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding StemSelection.Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" Margin="0,3">
                                        <CheckBox.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="12" />
                                                <TextBlock Text=" [No Disp.]" Foreground="#E74C3C" FontSize="10" Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                            </StackPanel>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 3: Output Folder Picker -->
                <Border Background="#20242D" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="3. Carpeta de Exportación" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <Button Content="📁 Elegir Carpeta..." Style="{StaticResource FluentSecondaryButtonStyle}" Click="OnSelectFolderClick" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding OutputFolderPath}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Section 4: Device Selector -->
                <Border Background="#20242D" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="4. Aceleración Hardware" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" Background="#181B22" Foreground="White" Height="30" />
                    </StackPanel>
                </Border>

                <!-- CTA Button: Separar y Exportar -->
                <Button Content="🚀 Separar y Exportar" Style="{StaticResource FluentPrimaryButtonStyle}" Command="{Binding StartSeparationCommand}" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}" Height="44" FontSize="15" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
