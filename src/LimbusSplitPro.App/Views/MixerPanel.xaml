<UserControl x:Class="LimbusSplitPro.App.Views.MixerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="650">
    <Border Background="#0A0A0F" CornerRadius="12" Margin="4" Padding="20" BorderBrush="#1E2230" BorderThickness="1">
        <Grid>

            <!-- ═══════════════════════════════════════════ -->
            <!-- STATE 1: Empty / Waiting                  -->
            <!-- Visible when: not processing AND no results -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- Show only when not processing AND no results yet -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsProcessing}" Value="False" />
                                    <Condition Binding="{Binding HasNoResults}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🎚" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.3" />
                <TextBlock Text="Los WAV aparecerán aquí al terminar." Foreground="#6B7280" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,0,0,6" />
                <TextBlock Text="Usa 'Cargar proyecto existente' para reabrir una separación anterior." Foreground="#4B5563" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- STATE 2: Processing                        -->
            <!-- Visible when: IsProcessing = true          -->
            <!-- ═══════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════ -->
            <!-- STATE 2: Processing                        -->
            <!-- Visible when: IsProcessing = true          -->
            <!-- ═══════════════════════════════════════════ -->
            <!-- Grid fills available width. Text centered, progress bar stretches independently. -->
            <Grid Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}"
                  VerticalAlignment="Center" Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Label PROCESANDO -->
                <TextBlock Grid.Row="0"
                           Text="PROCESANDO" FontSize="11" FontWeight="SemiBold"
                           Foreground="#6B7280" Margin="0,0,0,8"
                           HorizontalAlignment="Center" />

                <!-- Título de estado — centrado, wrapping evita overflow -->
                <TextBlock Grid.Row="1"
                           Text="{Binding SeparationStateText}"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,16" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" />

                <!-- Descripción de etapa (caja) -->
                <Border Grid.Row="2" Background="#12141A" CornerRadius="8"
                        Padding="14" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#00F0FF" />
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="{Binding CurrentStageText}" Foreground="#A0A5B1"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ProgressBar: Stretch = ancho siempre igual al Grid padre,
                     INDEPENDIENTE del texto arriba que cambia durante procesamiento -->
                <ProgressBar Grid.Row="3"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProcessingProgress}"
                             Height="6" Margin="0,0,0,10"
                             HorizontalAlignment="Stretch"
                             Foreground="#00F0FF" Background="#1E2230" BorderThickness="0" />

                <!-- Porcentaje -->
                <TextBlock Grid.Row="4"
                           Text="{Binding ProcessingProgress, StringFormat='⏳ {0:F0}% — Espera unos minutos...'}"
                           Foreground="#6B7280" FontSize="12"
                           HorizontalAlignment="Center" FontStyle="Italic" />
            </Grid>

            <!-- ═══════════════════════════════════════════ -->
            <!-- STATE 3: Results                           -->
            <!-- Visible when: NOT processing AND HasResults -->
            <!-- ═══════════════════════════════════════════ -->
            <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Results Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="RESULTADO" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4" />
                        <TextBlock Text="La exportación está preparada." Foreground="White" FontSize="20" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Abrir ubicación de archivos button (top of right panel, above transport buttons and stems) -->
                    <Button Grid.Column="1" Command="{Binding OpenOutputFolderCommand}"
                            VerticalAlignment="Center" Cursor="Hand" Padding="12,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="folderBorder" Background="#12141A" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁 " FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Abrir ubicación de archivos" FontSize="12" FontWeight="SemiBold" Foreground="#00F0FF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="folderBorder" Property="Background" Value="#0D2A32" />
                                        <Setter TargetName="folderBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="folderBorder" Property="Background" Value="#0A1E24" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Info + Transport Bar -->
                <Border Grid.Row="1" Background="#12141A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Track count info -->
                        <TextBlock Grid.Column="0" Foreground="#A0A5B1" FontSize="11" VerticalAlignment="Center">
                            <Run Text="•" Foreground="#00F0FF" FontSize="14" />
                            <Run Text=" " />
                            <Run Text="{Binding MixerTracks.Count, Mode=OneWay, StringFormat='{}{0} pistas WAV generadas'}" />
                        </TextBlock>

                        <!-- Transport buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Play button — vector icons, no emoji -->
                            <Button Command="{Binding PlayPauseCommand}" Width="30" Height="30" Padding="0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="pb" Background="#00F0FF" CornerRadius="6">
                                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="10" Height="10">
                                                    <!-- PLAY: triangle -->
                                                    <Path Fill="#0A0A0F"
                                                          Data="M 0,0 L 10,5 L 0,10 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <!-- PAUSE: two bars as single Path geometry -->
                                                    <Path Fill="#0A0A0F"
                                                          Data="M 0,0 H 3 V 10 H 0 Z M 5,0 H 8 V 10 H 5 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pb" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Stop button: red -->
                            <Button Command="{Binding StopCommand}" Padding="8,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sb" Background="#2A1215" CornerRadius="6" BorderBrush="#EF4444" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="9" Height="9" Background="#EF4444" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="Stop" FontSize="11" Foreground="#EF4444" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sb" Property="Background" Value="#3D1519" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Track List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding MixerTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Track card with subtle color tint overlay -->
                                <Border x:Name="trackCard" CornerRadius="10" Margin="0,0,0,6"
                                        BorderBrush="#1E2230" BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Dark base layer -->
                                        <Border Background="#0D0F14" CornerRadius="9" />
                                        <!-- Colour tint layer (7% opacity of stem colour) -->
                                        <Border Background="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                Opacity="0.07" CornerRadius="9" />
                                        <!-- Content layer -->
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Color badge -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}">
                                                <TextBlock Text="🎵" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                            </Border>

                                            <!-- Track name + format (double click volume readout to reset) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Control.PreviewMouseDoubleClick="OnVolumeSliderMouseDoubleClick"
                                                        Cursor="Hand" ToolTip="Doble clic para restablecer volumen a 100%">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="#6B7280" FontSize="10">
                                                    <Run Text="WAV  ·  " />
                                                    <Run Text="{Binding Volume, StringFormat='{}{0:P0}'}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Mute / Solo -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <ToggleButton Style="{StaticResource MuteButtonStyle}" IsChecked="{Binding IsMuted}" Margin="0,0,4,0" />
                                                <ToggleButton Style="{StaticResource SoloButtonStyle}" IsChecked="{Binding IsSolo}" />
                                            </StackPanel>

                                            <!-- Volume slider (double-click resets to 100%) -->
                                            <Slider Grid.Column="3" Minimum="0.0" Maximum="1.5" Value="{Binding Volume}"
                                                    VerticalAlignment="Center"
                                                    Control.PreviewMouseDoubleClick="OnVolumeSliderMouseDoubleClick"
                                                    ToolTip="Doble clic para restablecer a 100%" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter TargetName="trackCard" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Border>
</UserControl>
