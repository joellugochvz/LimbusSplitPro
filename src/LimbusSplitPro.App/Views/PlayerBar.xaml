<UserControl x:Class="LimbusSplitPro.App.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800">
    <Border Background="#0D0D14" BorderBrush="#1E2230" BorderThickness="0,1,0,0" Padding="16,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Row: Timeline Seek Slider -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Seek Slider: custom dark/neon template -->
                <Slider Grid.Column="0"
                        Minimum="0" Maximum="{Binding TotalDurationSeconds, FallbackValue=100}"
                        Value="{Binding SeekSliderValue, Mode=TwoWay}"
                        ValueChanged="OnSeekValueChanged"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        IsMoveToPointEnabled="True"
                        Cursor="Hand">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="20" VerticalAlignment="Center">
                                 <!-- Track background -->
                                <Border Height="4" CornerRadius="2"
                                        Background="#1E2230"
                                        VerticalAlignment="Center"/>
                                <!-- Track fill (progress trail behind thumb) -->
                                <ProgressBar Height="4"
                                             Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                             Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                             Foreground="#008C99"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False"/>
                                <!-- Native Track (handles hit-testing and thumb position) -->
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Background="Transparent" BorderThickness="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Background="Transparent" BorderThickness="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse x:Name="ThumbCircle"
                                                                 Width="14" Height="14"
                                                                 Fill="#00F0FF"
                                                                 Stroke="#0A0A0F" StrokeThickness="1.5"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbCircle" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="ThumbCircle" Property="Width" Value="16"/>
                                                            <Setter TargetName="ThumbCircle" Property="Height" Value="16"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbCircle" Property="Fill" Value="#33F3FF"/>
                                                            <Setter TargetName="ThumbCircle" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="1.0"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
                <TextBlock Grid.Column="1" Text="{Binding FormattedTimeText}" Foreground="#6B7280" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas" />
            </Grid>

            <!-- Bottom Row: Transport & Status -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Transport Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Play/Pause: Cyan circle with vector icon (no emoji) -->
                    <Button Command="{Binding PlayPauseCommand}" Width="36" Height="36" Padding="0" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="playBorder" Background="#00F0FF" CornerRadius="18">
                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="10" Height="10">
                                            <!-- PLAY: triangle -->
                                            <Path Fill="#0A0A0F"
                                                  Data="M 0,0 L 10,5 L 0,10 Z">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <!-- PAUSE: two bars as single Path geometry -->
                                            <Path Fill="#0A0A0F"
                                                  Data="M 0,0 H 3 V 10 H 0 Z M 5,0 H 8 V 10 H 5 Z">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="playBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Stop: Red circle -->
                    <Button Command="{Binding StopCommand}" Width="36" Height="36" Padding="0" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="stopBorder" Background="#2A1215" CornerRadius="18" BorderBrush="#EF4444" BorderThickness="1.5">
                                    <Border Width="12" Height="12" Background="#EF4444" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="stopBorder" Property="Background" Value="#3D1519" />
                                        <Setter TargetName="stopBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="0.4" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Status Messages -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <!-- Stage text with optional neon-green check -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Neon green vector check (only when project is loaded / separation done) -->
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProjectLoaded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <Canvas Width="12" Height="12">
                                <Path Data="M 1,6 L 4.5,10 L 11,2"
                                      Stroke="#22FF77" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#22FF77" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                    </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding CurrentStageText}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}" Height="3" Margin="0,4,0,0" 
                                 Foreground="#00F0FF" Background="#1E2230" BorderThickness="0"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#6B7280" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Export & Load Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Abrir proyecto: loads existing stems folder into mixer -->
                    <Button Click="OnLoadProjectClick" Padding="12,6" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="loadBorder" Background="#0E1017" CornerRadius="8"
                                        BorderBrush="#2A3040" BorderThickness="1.5"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="📂 Cargar proyecto" FontSize="11" Foreground="#A0A5B1" FontWeight="SemiBold" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="loadBorder" Property="BorderBrush" Value="#00F0FF" />
                                        <Setter TargetName="loadBorder" Property="Background" Value="#0D1C24" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="loadBorder" Property="Background" Value="#0A1520" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Exportar Mezcla: Cyan styled -->
                    <Button Command="{Binding ExportMixCommand}" Padding="12,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="exportBorder" Background="#0A1A1F" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="💾 Exportar Mezcla" FontSize="11" Foreground="#00F0FF" FontWeight="SemiBold" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="exportBorder" Property="Background" Value="#0D2A32" />
                                        <Setter TargetName="exportBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
